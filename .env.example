JWT_SECRET=replace-with-at-least-32-random-characters
# 启动脚本不自动读取 .env；请将需要的配置设置为环境变量。
# SMARTGRADE_TOOLS=C:\SmartGradeTools
# SENTINEL_DASHBOARD_JAR=C:\SmartGradeTools\sentinel\sentinel-dashboard.jar
MYSQL_USER=smartgrade
MYSQL_PASSWORD=smartgrade123
NACOS_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=1111
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
SENTINEL_DASHBOARD=127.0.0.1:8858
SERVICE_TOKEN=local-service-token

# 启用 infra profile 后使用 MySQL、Redis、Kafka 与 MinIO；默认本地演示不需要这些组件。
# SPRING_PROFILES_ACTIVE=infra
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=smartgrade
MINIO_SECRET_KEY=smartgrade123
MINIO_BUCKET=smartgrade
NOTIFICATION_URL=http://127.0.0.1:8087
# 可选：覆盖 C04 到 C03 的服务发现地址，留空时通过 Nacos + LoadBalancer。
ANSWER_SERVICE_URL=

# 手写识别使用 OpenAI 兼容的多模态接口。API Key 只放在环境变量中，不提交到仓库。
VISION_OCR_PROVIDER=vision-llm
VISION_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus
VISION_API_KEY=
